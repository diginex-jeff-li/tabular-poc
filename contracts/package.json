{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./compliance-library": {
      "types": "./dist/types/compliance-library/index.d.ts",
      "import": "./dist/esm/compliance-library/index.js"
    },
    "./compliance-library/routes": {
      "types": "./dist/types/compliance-library/routes/index.d.ts",
      "import": "./dist/esm/compliance-library/routes/index.js"
    },
    "./compliance-library/requests": {
      "types": "./dist/types/compliance-library/requests/index.d.ts",
      "import": "./dist/esm/compliance-library/requests/index.js"
    },
    "./compliance-library/responses": {
      "types": "./dist/types/compliance-library/responses/index.d.ts",
      "import": "./dist/esm/compliance-library/responses/index.js"
    },
    "./compliance-library/schemas": {
      "types": "./dist/types/compliance-library/schemas/index.d.ts",
      "import": "./dist/esm/compliance-library/schemas/index.js"
    },
    "./common": {
      "types": "./dist/types/common/index.d.ts",
      "import": "./dist/esm/common/index.js"
    },
    "./common/schemas": {
      "types": "./dist/types/common/schemas/index.d.ts",
      "import": "./dist/esm/common/schemas/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "swc src -d dist/esm --strip-leading-paths --extensions '.ts' -C module.type=es6 -C sourceMaps=true",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:types",
    "fmt": "oxfmt --write \"src/**/*.ts\"",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}