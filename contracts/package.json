{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "swc src -d dist/esm --strip-leading-paths --extensions '.ts' -C module.type=es6 -C sourceMaps=true",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:types",
    "fmt": "vp fmt --write \"src/**/*.ts\"",
    "lint": "vp lint src",
    "test": "vp test run",
    "test:watch": "vp test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite-plus": "1.8.0"
  }
}
