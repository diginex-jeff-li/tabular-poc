{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "contracts": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["dist/**"]
    },
    "frontend/apps/admin": {
      "entry": ["src/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "src/types/auto-imports.d.ts"]
    },
    ".": {
      "project": ["scripts/**/*.mjs"]
    }
  },
  "ignore": [".wayfinder/**"]
}
