{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "contracts": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["dist/**"]
    },
    ".": {
      "entry": ["src/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
      "ignore": ["src/types/auto-imports.d.ts"]
    }
  },
  "ignore": [".wayfinder/**"]
}
