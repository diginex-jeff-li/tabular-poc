{
  "name": "sc-tabulator",
  "version": "0.1.0",
  "private": true,
  "description": "Tabulator grid editor prototype — compliance library admin grid",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sc/admin dev",
    "build": "pnpm --filter contracts build && pnpm --filter @sc/admin build",
    "lint": "pnpm -r run lint && oxlint .",
    "fmt": "pnpm -r run fmt && oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "pnpm --filter contracts build && pnpm --filter @sc/admin typecheck",
    "test": "pnpm --filter contracts test && pnpm --filter @sc/admin test",
    "knip": "knip",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run knip"
  },
  "devDependencies": {
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "packageManager": "pnpm@11.7.0"
}