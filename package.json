{
  "name": "sc-tabulator",
  "version": "0.1.0",
  "private": true,
  "description": "Spreadsheet-style grid prototype on TanStack Table — compliance library admin grid and bulk invite",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "lint": "vp lint .",
    "fmt": "vp fmt --write \"**/*.{ts,tsx}\"",
    "fmt:check": "vp fmt --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "knip": "knip",
    "jscpd": "jscpd --pattern '**/*.{ts,tsx}' --ignore '**/node_modules/**,**/dist/**,**/*.test.ts,**/*.d.ts'",
    "agents:check": "node scripts/check-agents-md.mjs",
    "prepare": "vp config --no-agent",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run knip"
  },
  "dependencies": {
    "@nuxt/ui": "4.13.1",
    "@vueuse/core": "15.1.0",
    "exceljs": "4.4.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vue/test-utils": "2.6.0",
    "happy-dom": "21.0.4",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "unplugin-auto-import": "21.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "packageManager": "pnpm@12.23.0"
}
