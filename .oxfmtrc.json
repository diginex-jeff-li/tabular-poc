{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      "value-builtin",
      "value-external",
      "value-internal",
      "value-index",
      "value-sibling",
      "value-parent",
      "type"
    ],
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "**/node_modules/",
    "**/public/",
    "**/dist/",
    "**/build/",
    "pnpm-lock.yaml",
    "**/package.json",
    "**/auto-imports.d.ts"
  ]
}
