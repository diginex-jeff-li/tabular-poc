{
  "name": "bp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @bp/admin dev",
    "build": "pnpm --filter @bp/admin build",
    "preview": "pnpm --filter @bp/admin preview",
    "typecheck": "pnpm --filter @bp/admin typecheck",
    "lint": "oxlint apps",
    "fmt": "oxfmt --write \"apps/**/src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sass": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
