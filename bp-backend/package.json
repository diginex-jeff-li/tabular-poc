{
  "name": "bp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "tsc": "tsc --noEmit",
    "lint": "oxlint apps libs",
    "fmt": "oxfmt --write \"apps/**/src/**/*.ts\" \"libs/**/src/**/*.ts\"",
    "test": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typeorm": "typeorm -d dist/apps/api/src/config/data-source.js",
    "migration:run": "pnpm build && node dist/apps/api/src/migrate.js run",
    "migration:revert": "pnpm build && node dist/apps/api/src/migrate.js revert",
    "seed": "pnpm build && node dist/apps/api/src/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/nest": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/shared": "catalog:",
    "@orpc/standard-server": "catalog:",
    "@orpc/standard-server-fastify": "catalog:",
    "@orpc/standard-server-fetch": "catalog:",
    "@orpc/standard-server-node": "catalog:",
    "@orpc/standard-server-peer": "catalog:",
    "bp-contracts": "workspace:*",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typeorm": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@types/uuid": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "tsconfig-paths": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
